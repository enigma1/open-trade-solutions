---
import Page from ">/components/Page.astro";
import Pagination from ">/components/Pagination.astro";
import Breadcrumb from ">/components/Breadcrumb.astro";
import { getCategoriesFromRequest } from ">/lib/server/categories";
import { CategoriesGrid, CategoryGridEmpty } from ">/components/categories";
import {
  createRequestContext,
  buildCategoriesListingContext,
} from ">/lib/server/page-context";
import type { CategoryListType } from ">/lib/shared/types";
import ListingIntro from ">/components/ListingIntro.astro";

const ctx = await createRequestContext(Astro);
const { lang, t, url } = ctx;

const context = await buildCategoriesListingContext(url.searchParams, t);
const categoriesData = await getCategoriesFromRequest(url.searchParams);

const { items, pagination } = categoriesData;
let categories: CategoryListType[] = [];
const isEmpty = items.length === 0;

if (!isEmpty) {
  categories = items.map((row) => ({
    id: row.category.categories_id,
    image: row.category.categories_image,
    name: row.content.categories_name,
  }));
}
---

<Page title={context.title}>
  {isEmpty ? (
    <CategoryGridEmpty />
  ) : (
    <>
      <div class="mb-3">
        {context.breadcrumb.length > 0 && (
          <div class="bg-surface-muted px-4 py-2 rounded-md">
            <Breadcrumb segments={context.breadcrumb} />
          </div>
        )}
      </div>
      <div class="mb-3">
        {context.type === "category" && (
          <ListingIntro
            title={`Subcategories in ${context?.entity?.name}`}
            description={context?.entity?.description}
            image={context?.entity?.image}
          />
        )}

        {context.type === "brand" && (
          <ListingIntro
            title={`Categories from ${context?.entity?.name}`}
            description={context?.entity?.description}
            image={context?.entity?.image}
            align="right"
          />
        )}
      </div>
      <CategoriesGrid categories={categories} />
      <Pagination
        itemsShown={items.length}
        offset={pagination.offset}
        limit={pagination.limit}
        hasNext={pagination.hasNext}
        hasPrevious={pagination.hasPrevious}
      />
    </>
  )}
</Page>
