---
import { CartIcon } from '>/islands';
const { cookiesDisabled = false } = Astro.props;
---

<header class="bg-white shadow-sm border-b">
  {cookiesDisabled && (
    <div class="bg-amber-100 border-b border-amber-300 text-amber-800 text-sm px-4 py-2 text-center">
      Cookies are disabled in your browser. Some features (cart, preferences)
      may not work until you enable them.
    </div>
  )}
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center gap-4">
    <!-- Logo -->
    <div class="font-bold text-lg">MyStore</div>

    <!-- Search (grow) -->
    <div class="flex-1">
      <input
        type="text"
        placeholder="Search products..."
        class="w-full border rounded px-3 py-2"
      />
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-4">
      <select class="border rounded px-2 py-1">
        <option>EN</option>
        <option>FR</option>
      </select>

      <select class="border rounded px-2 py-1">
        <option>USD</option>
        <option>EUR</option>
      </select>

      <CartIcon client:load cookiesDisabled={cookiesDisabled} />
    </div>
  </div>
</header>
