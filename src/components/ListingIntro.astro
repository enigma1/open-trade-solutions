---
interface Props {
  title: string;
  description?: string;
  image?: string;
  align?: 'left' | 'right';
}

const { title, description, image, align = 'left' } = Astro.props;
---

<div class='bg-surface-muted rounded-lg p-4 md:p-4'>
  <div
    class={`flex flex-col gap-4 md:gap-6 ${
      image ? 'md:flex-row' : ''
    } ${align === 'right' ? 'md:flex-row-reverse' : ''}`}
  >
    {
      image && (
        <img
          src={image}
          alt={title}
          class='w-full md:w-48 lg:w-64 h-auto object-cover rounded-md'
        />
      )
    }

    <div class='flex-1'>
      <h1 class='text-2xl font-bold text-text mb-2'>
        {title}
      </h1>

      {description && <p class='text-muted leading-relaxed'>{description}</p>}
    </div>
  </div>
</div>
