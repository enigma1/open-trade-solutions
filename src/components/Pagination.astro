---
import { ChevronLeft, ChevronRight } from "lucide-astro";
import { calculatePageNumber } from ">/lib/server/page-listings";
const { offset, limit, hasNext, hasPrevious, itemsShown } = Astro.props;
const page = calculatePageNumber(offset, limit);
---

<div class="flex items-center justify-center space-x-4 mt-8">
  {hasPrevious && (
    <a
      href={`?page=${page - 1}`}
      class="px-4 py-2 bg-surface border border-border rounded hover:bg-surface-muted transition"
    >
      <ChevronLeft size={24} />
    </a>
  )}

  <div class="text-sm text-text-muted flex items-center space-x-2">
    <span>Page {page}</span>
    <span>•</span>
    <span>{itemsShown} items</span>
  </div>

  {hasNext && (
    <a
      href={`?page=${page + 1}`}
      class="px-4 py-2 bg-surface border border-border rounded hover:bg-surface-muted transition"
    >
      <ChevronRight size={24} />
    </a>
  )}
</div>
