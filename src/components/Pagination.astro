---
const { page, perPage, hasMore, itemsShown } = Astro.props;
---

<div class='flex items-center justify-center space-x-4 mt-8'>
  {
    page > 1 && (
      <a
        href={`?page=${page - 1}&perPage=${perPage}`}
        class='px-4 py-2 bg-surface border border-border rounded hover:bg-surface-muted transition'
      >
        Previous
      </a>
    )
  }

  <div class='text-sm text-text-muted flex items-center space-x-2'>
    <span>Page {page}</span>
    <span>•</span>
    <span>{itemsShown} items</span>
  </div>

  {
    hasMore && (
      <a
        href={`?page=${page + 1}&perPage=${perPage}`}
        class='px-4 py-2 bg-surface border border-border rounded hover:bg-surface-muted transition'
      >
        Next
      </a>
    )
  }
</div>
