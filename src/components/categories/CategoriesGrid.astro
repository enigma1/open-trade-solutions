---
import type { CategoryListType } from '@/lib/shared/types';
import CategoryGridCard from './CategoryGridCard.astro';

const { categories } = Astro.props;

interface Props {
  categories: CategoryListType[];
}
---

<div class='grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4'>
  {categories.map((c) => <CategoryGridCard category={c} />)}
</div>
