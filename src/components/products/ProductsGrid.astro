---
import type { ProductFullType } from '>/lib/shared/types';
import ProductGridCard from './ProductGridCard.astro';

const { products } = Astro.props;

interface Props {
  products: ProductFullType[];
}
---

<div
  class='grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 p-4 bg-surface'
>
  {products.map((p) => <ProductGridCard product={p} />)}
</div>
