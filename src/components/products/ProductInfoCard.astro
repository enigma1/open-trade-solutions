---
import type { ProductFullType } from '>/lib/shared/types';

const { productInfo } = Astro.props;
const { product, special, content } = productInfo;
interface Props {
  productInfo: ProductFullType;
}
const inStock = product.products_status === 1;
---

<h1 class='text-2xl font-bold pb-3 bg-white'>
  {content.products_name}
</h1>

<div class='grid grid-cols-1 lg:grid-cols-3 gap-6'>
  <!-- LEFT: Main content -->
  <div class='lg:col-span-2 flex flex-col gap-4'>
    <img
      src={`/images/${product.products_image}`}
      alt={content.products_name}
      class='w-full max-h-400 object-contain rounded border shadow-sm'
    />

    <div class='prose max-w-none'>
      <p>{content.products_description}</p>
    </div>
  </div>

  <!-- RIGHT: Purchase panel -->
  <div class='border rounded-lg p-4 shadow-sm flex flex-col gap-3 h-fit'>
    <p class='text-xl font-semibold'>
      £{Number(product.products_price).toFixed(2)}
    </p>

    <p class='text-sm text-gray-600'>
      Model: {product.products_model}
    </p>

    <p class='text-sm text-gray-600'>
      Added: {product.products_date_added.toLocaleDateString()}
    </p>

    <p
      class={`text-sm font-medium ${inStock ? 'text-green-600' : 'text-red-600'}`}
    >
      {inStock ? 'In Stock' : 'Out of Stock'}
    </p>

    <button
      class='mt-4 bg-blue-600 text-white py-2 px-4 rounded hover:bg-blue-700 transition disabled:bg-gray-400'
      disabled={!inStock}
    >
      Buy Now
    </button>
  </div>
</div>
