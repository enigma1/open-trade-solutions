---
import { currencyApi } from '>/lib/server/request';
import type { ProductFullType } from '>/lib/shared/types';

const currency = await currencyApi.resolveCurrency();
const { productInfo } = Astro.props;
const { product, content } = productInfo;

interface Props {
  productInfo: ProductFullType;
}
const inStock = product.products_status === 1;
---

<h1 class="product-title">{content.products_name}</h1>

<div class="product-grid">
  <!-- LEFT: Main content -->
  <div class="product-main-content">
    <img
      src={`/images/${product.products_image}`}
      alt={content.products_name}
      class="product-image"
    />

    <div class="product-description">
      <p>{content.products_description}</p>
    </div>
  </div>

  <!-- RIGHT: Purchase panel -->
  <div class="product-purchase-panel">
    <p class="product-price">
      {currencyApi.formatCurrency(product.products_price, currency)}
    </p>

    <p class="product-meta">Model: {product.products_model}</p>

    <p class="product-meta">
      Added: {product.products_date_added.toLocaleDateString()}
    </p>

    <p
      class={`product-stock-status ${inStock ? 'product-stock-in' : 'product-stock-out'}`}
    >
      {inStock ? 'In Stock' : 'Out of Stock'}
    </p>

    <button class="product-buy-button" disabled={!inStock}>
      Buy Now
    </button>
  </div>
</div>
