{
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolvePackageJsonExports": true,
    "paths": {
      ">/*": [
        "./src/*"
      ],
      "</*": [
        "./*"
      ]
    },
    "jsxImportSource": "react"
  }
}