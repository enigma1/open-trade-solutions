{
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "jsx": "preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolvePackageJsonExports": false,
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./*"]
    }
  }
}
